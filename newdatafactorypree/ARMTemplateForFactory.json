						"          {Modified Date} as timestamp",
						"     ),",
						"     order: 0,",
						"     allowSchemaDrift: true) ~> input1",
						"input1 derive(AddDateTime = currentUTC()) ~> derivedColumn1",
						"derivedColumn1 output() ~> output1"
					]
				}
			},
