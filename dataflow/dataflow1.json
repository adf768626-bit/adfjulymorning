{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStorageLS",
						"type": "LinkedServiceReference"
					},
					"name": "employees"
				},
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStorageLS",
						"type": "LinkedServiceReference"
					},
					"name": "deparments"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStorageLS",
						"type": "LinkedServiceReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "join1"
				},
				{
					"name": "flowlet1",
					"flowlet": {
						"referenceName": "AddDateTime",
						"type": "DataFlowReference"
					}
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          EmployeeID as short,",
				"          EmployeeName as string,",
				"          Email as string,",
				"          DepartmentID3 as short,",
				"          JobTitle as string,",
				"          Salary as integer,",
				"          DepartmentID6 as short,",
				"          DepartmentName as string,",
				"          Location as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     fileSystem: 'rawdata',",
				"     fileName: 'employees.csv',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> employees",
				"source(output(",
				"          DepartmentID as short,",
				"          DepartmentName as string,",
				"          Location as string",
				"     ),",
				"     useSchema: false,",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'delimited',",
				"     fileSystem: 'rawdata',",
				"     fileName: 'departments.csv',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true) ~> deparments",
				"join1 select(mapColumn(",
				"          EmployeeID,",
				"          EmployeeName,",
				"          Email,",
				"          JobTitle,",
				"          Salary,",
				"          DepartmentName = employees@DepartmentName,",
				"          Location = employees@Location,",
				"          DepartmentID",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"employees, deparments join(DepartmentID3 == DepartmentID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"derivedColumn1 compose(mapColumn(",
				"          {Modified Date}",
				"     ),",
				"     composition: 'AddDateTime') ~> flowlet1@(output1)",
				"select1 derive({Modified Date} = currentTimestamp()) ~> derivedColumn1",
				"flowlet1@output1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delimited',",
				"     fileSystem: 'sink',",
				"     folderPath: 'transformed_join.csv',",
				"     columnDelimiter: ',',",
				"     escapeChar: '\\\\',",
				"     quoteChar: '\\\"',",
				"     columnNamesAsHeader: true,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}